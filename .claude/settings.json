{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(make test*)",
      "Bash(make lint*)",
      "Bash(make up)",
      "Bash(make ps)",
      "Bash(make logs*)",
      "Bash(make fresh)",
      "Bash(make smoke)",
      "Bash(make e2e)",

      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose build*)",
      "Bash(docker compose up -d*)",
      "Bash(docker compose exec *)",
      "Bash(docker compose run --rm *)",

      "Bash(php artisan test*)",
      "Bash(php artisan route:list*)",
      "Bash(php artisan migrate:status*)",
      "Bash(php artisan config:show*)",
      "Bash(php artisan llm:eval*)",
      "Bash(vendor/bin/pest*)",
      "Bash(vendor/bin/pint*)",
      "Bash(vendor/bin/phpstan*)",

      "Bash(npm run lint*)",
      "Bash(npm run test*)",
      "Bash(npm run type-check*)",
      "Bash(npm run build*)",
      "Bash(npx playwright test*)",

      "Bash(node scripts/test-guard.mjs)",
      "Bash(node scripts/test-format.mjs)",
      "Bash(node scripts/test-scrub.mjs)",
      "Bash(node scripts/scrub-sessions.mjs*)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git switch*)",
      "Bash(git checkout -b*)",

      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",

      "Bash(ls*)",
      "Bash(curl http://localhost:*)",

      "mcp__context7",
      "mcp__laravel-boost"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(composer require*)",
      "Bash(npm install *)",
      "Bash(docker compose down -v*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.testing)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.testing)",
      "Edit(**/.env.production)",
      "Edit(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*credentials*)",
      "Bash(git clean*)",
      "Bash(git reset --hard*)",
      "Bash(docker system prune*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 40
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["context7"],
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  }
}
