<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Forced so the container's env_file (APP_ENV=local, the development database,
             Redis db 0) can never leak into a test run (K4). These are <server> entries
             because Laravel reads $_SERVER before $_ENV. -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="campaign_test" force="true"/>
        <server name="REDIS_DB" value="1" force="true"/>
        <!-- The container sets CACHE_STORE=redis, and a plain <env> does not override it: tests then shared
             (and flushed) the development cache, for example the city list. -->
        <server name="CACHE_STORE" value="array" force="true"/>
        <!-- Logs go to stderr as JSON in the containers; a test run must not print them. Tests that check
             logging spy on the Log facade. -->
        <server name="LOG_CHANNEL" value="null" force="true"/>
        <!-- Tests queue their own fake LLM scenarios; the ready-made dev answers would hide a missing one. -->
        <server name="LLM_FAKE_DEV_SCENARIOS" value="false" force="true"/>
        <!-- A key in the container's env_file must not turn a test run into real model calls (K28). -->
        <server name="LLM_DRIVER" value="fake" force="true"/>
        <server name="ANTHROPIC_API_KEY" value="" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
