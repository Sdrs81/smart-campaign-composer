APP_NAME="Smart Campaign Composer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=campaign
DB_USERNAME=campaign
DB_PASSWORD=

# Redis: queue, global rate limiter, locks
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=array

# LLM: auto = Claude when ANTHROPIC_API_KEY is set, otherwise the offline fake client
LLM_DRIVER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Delivery
PROVIDER_URL=http://mock-provider:8080
SEND_RATE_PER_SECOND=100
WORKERS_PER_CHANNEL=8

# Mock provider fault injection (rates are 0..1, latency in milliseconds)
MOCK_LATENCY_MIN_MS=10
MOCK_LATENCY_MAX_MS=80
MOCK_RATE_500=0.05
MOCK_RATE_429=0.02
MOCK_RATE_TIMEOUT=0.01
MOCK_RATE_ACCEPT_THEN_500=0.02
